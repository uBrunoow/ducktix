# Copie para .env.local e ajuste se necessário.
# Postgres do docker-compose.yml (porta 5433 para não colidir com um Postgres local).
DATABASE_URL="postgresql://ducktix:ducktix@localhost:5433/ducktix"

# Em produção (Vercel + Neon), DATABASE_URL aponta para a connection string do
# Neon e o driver muda automaticamente — ver src/server/db/client.ts.
BLOB_READ_WRITE_TOKEN=""

# Resend — substitua pelo valor real da sua conta.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
APP_URL="http://localhost:3000"
