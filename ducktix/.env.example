# Copie para .env.local e ajuste se necessário.

# MongoDB do docker-compose.yml (sem autenticação, só para desenvolvimento).
MONGODB_URI="mongodb://localhost:27017"
# Database usado pela aplicação. Os testes usam "ducktix_test" por conta própria.
MONGODB_DB="ducktix"

# Vercel Blob — upload de capas de evento e fotos de perfil. Opcional no
# desenvolvimento: sem ele, o upload de imagem falha e o resto funciona.
BLOB_READ_WRITE_TOKEN=""

# Resend — substitua pelo valor real da sua conta.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
APP_URL="http://localhost:3000"
